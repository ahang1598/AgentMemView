{
  "name": "@agentmemview/proxy",
  "version": "0.1.0",
  "description": "AgentMemView transparent proxy: dual-protocol adapter, injection pipeline, L0 write-back",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./onboard/*": {
      "types": "./dist/onboard/*.d.ts",
      "default": "./dist/onboard/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@agentmemview/core": "workspace:*",
    "hono": "^4.13.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3",
    "vitest": "^3.2.0"
  }
}
